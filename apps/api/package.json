{
  "name": "@scp/api",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/main.js",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run --exclude '**/*.seguranca.test.ts'",
    "generate:openapi": "node dist/openapi/generate-openapi.js",
    "test:integration": "vitest run --exclude '**/*.seguranca.test.ts' --config vitest.integration.config.ts",
    "test:seguranca": "vitest run seguranca.test --passWithNoTests --coverage.reportsDirectory=coverage/seguranca --config vitest.integration.config.ts"
  },
  "dependencies": {
    "@nestjs/common": "12.3.2",
    "@nestjs/core": "12.3.2",
    "@nestjs/platform-express": "12.3.2",
    "@nestjs/swagger": "12.1.0",
    "@scp/shared": "workspace:*",
    "@sentry/node": "11.10.0",
    "pg": "8.23.1",
    "pino": "10.4.0",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2"
  },
  "devDependencies": {
    "@scp/config": "workspace:*",
    "@swc/core": "1.16.21",
    "@testcontainers/postgresql": "12.2.1",
    "@types/node": "26.6.6",
    "@types/pg": "8.23.1",
    "@vitest/coverage-v8": "5.1.0",
    "testcontainers": "12.2.1",
    "typescript": "~6.0.3",
    "unplugin-swc": "2.0.0",
    "vitest": "5.1.0"
  }
}
