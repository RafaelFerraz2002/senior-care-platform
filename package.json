{
  "name": "senior-care-platform",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.16.1",
  "engines": {
    "node": ">=26 <27"
  },
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "build": "turbo run build",
    "lint": "eslint .",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "test:integration": "turbo run test:integration",
    "test:seguranca": "turbo run test:seguranca",
    "test:e2e": "turbo run test:e2e",
    "test:all": "turbo run test test:integration test:seguranca test:e2e",
    "generate:api-client": "turbo run build --filter=@scp/api && pnpm --filter @scp/api generate:openapi && pnpm --filter @scp/api-client generate",
    "check:size": "node scripts/check-size.mjs",
    "prepare": "lefthook install"
  },
  "devDependencies": {
    "@scp/config": "workspace:*",
    "eslint": "10.14.0",
    "lefthook": "2.2.2",
    "prettier": "3.9.10",
    "turbo": "2.11.10",
    "typescript": "~6.0.3"
  }
}
