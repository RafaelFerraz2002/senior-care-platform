{
  "name": "senior-care-platform",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.16.1",
  "engines": {
    "node": ">=26 <27"
  },
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "build": "turbo run build",
    "lint": "eslint .",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "test:integracao": "turbo run test:integracao",
    "test:e2e": "turbo run test:e2e",
    "test:tudo": "turbo run test test:integracao test:e2e",
    "gerar:api-client": "turbo run build --filter=@scp/api && pnpm --filter @scp/api gerar:openapi && pnpm --filter @scp/api-client gerar",
    "verificar:tamanho": "echo 'verificar:tamanho: preenchido na Tarefa 9'",
    "prepare": "lefthook install"
  },
  "devDependencies": {
    "@scp/config": "workspace:*",
    "eslint": "10.14.0",
    "lefthook": "2.2.2",
    "prettier": "3.9.10",
    "turbo": "2.11.10",
    "typescript": "~6.0.3"
  }
}
