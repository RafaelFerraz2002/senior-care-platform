# Variáveis de ambiente locais (valores não secretos, só para desenvolvimento). Copiar para .env.

# Portas no anfitrião (mudar aqui se estiverem ocupadas)
POSTGRES_PORT=5440
MINIO_API_PORT=9010
MINIO_CONSOLE_PORT=9011
MAILPIT_SMTP_PORT=1035
MAILPIT_UI_PORT=8035

# Postgres: o superutilizador só serve para o arranque; a API usa sempre o papel app.
POSTGRES_DB=scp
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres-local
APP_DB_PASSWORD=app-local

# MinIO
MINIO_ROOT_USER=minio-local
MINIO_ROOT_PASSWORD=minio-local-pass

# API
API_PORT=3000
DATABASE_URL=postgresql://app:app-local@localhost:5440/scp
LOG_LEVEL=info
# SENTRY_DSN=

# Apps web (opcional)
# VITE_SENTRY_DSN=
