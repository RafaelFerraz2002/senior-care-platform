{
  "name": "@scp/fake-data",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run --exclude '**/*.seguranca.test.ts'",
    "test:seguranca": "vitest run seguranca.test --passWithNoTests --coverage.reportsDirectory=coverage/seguranca"
  },
  "dependencies": {
    "@faker-js/faker": "10.6.0"
  },
  "devDependencies": {
    "@scp/config": "workspace:*",
    "@vitest/coverage-v8": "5.1.0",
    "typescript": "~6.0.3",
    "vitest": "5.1.0"
  }
}
